# Better Auth Configuration
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# MongoDB Database Connection String (Supports any of these variable names)
BETTER_AUTH_DB_URL=mongodb://username:password@cluster.mongodb.net/?ssl=true&replicaSet=atlas-xxx&authSource=admin
MONGODB_URI=mongodb://username:password@cluster.mongodb.net/?ssl=true&replicaSet=atlas-xxx&authSource=admin
MONGODB_URL=mongodb://username:password@cluster.mongodb.net/?ssl=true&replicaSet=atlas-xxx&authSource=admin
DB_NAME=pizzaHubDB

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SERVER_URL=http://localhost:5000

# Optional Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
